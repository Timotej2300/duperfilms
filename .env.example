# Prisma MySQL (Aiven). Prisma nepozná "ssl-mode", používa "sslaccept".
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DBNAME?sslaccept=accept_invalid_certs"

# Verejná URL webu
NEXT_PUBLIC_SITE_URL="https://duperfilms.eu"

# Náhodný tajný kľúč (min. 32 znakov): openssl rand -base64 48
