# E-maily (Resend)
RESEND_API_KEY=""
EMAIL_FROM="DuperFilms <support@duperfilms.eu>"

# Stripe (etapa 9)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Seed prvého Ownera
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
